<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RuckuZ_Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RuckuZ">

    <Grid>
        <Grid.Resources>
        
            <FontFamily
                x:Key="RuckuZFont">
                ms-appx:///Assets/AprilshandwritingRegular-mpGj.otf#Aprils Handwriting
            </FontFamily>

            <Style
                x:Key="RuckuZImageButton"
                TargetType="Button">

                <Setter
                    Property="Background"
                    Value="Transparent"/>

                <Setter
                    Property="BorderBrush"
                    Value="Transparent"/>

                <Setter
                    Property="BorderThickness"
                    Value="0"/>

                <Setter
                    Property="Padding"
                    Value="0"/>

                <Setter
                    Property="FontFamily"
                    Value="{StaticResource RuckuZFont}"/>

            </Style>
        </Grid.Resources>

        <Grid.Background>
            <ImageBrush
                ImageSource="ms-appx:///Assets/bg/paper.png"
                Stretch="UniformToFill"/>

        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="1.08*"/>
            <ColumnDefinition
                Width="0.92*"/>
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="#F72F244D"
            BorderBrush="#6B58B8"
            BorderThickness="0,0,4,0">
            <Grid
                Padding="48">

                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="*"/>
                    <RowDefinition
                        Height="Auto"/>

                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="24">

                    <Image
                        Source="ms-appx:///Assets/logo/logo.png"
                        Width="500"
                        Stretch="Uniform"/>

                    <TextBlock
                        Text="Talk. Share. Cause a little RuckuZ."
                        HorizontalAlignment="Center"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        FontFamily="{StaticResource RuckuZFont}"
                        FontSize="25"
                        Foreground="#FFFDF6"/>

                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="16">

                    <Image
                        Source="ms-appx:///Assets/logo/logo3.png"
                        Width="72"
                        Height="72"/>

                    <TextBlock
                        Width="360"
                        VerticalAlignment="Center"
                        Text="A place to doodle, chat, share media and hang out."
                        TextWrapping="Wrap"
                        FontFamily="{StaticResource RuckuZFont}"
                        FontSize="19"
                        Foreground="#DED4F4"/>

                </StackPanel>
            </Grid>
        </Border>

        <Grid
            Grid.Column="1"
            Padding="40">

            <StackPanel
                Width="430"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14">

                <TextBlock
                    x:Name="AuthHeading"
                    Text="Welcome back"
                    FontFamily="{StaticResource RuckuZFont}"
                    FontSize="40"
                    Foreground="#30254F"/>

                <TextBlock
                    x:Name="AuthIntro"
                    Text="Login to your RuckuZ account."
                    Margin="0,-6,0,8"
                    FontFamily="{StaticResource RuckuZFont}"
                    FontSize="18"
                    Foreground="#655E72"/>

                <Grid
                    ColumnSpacing="12">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*"/>
                        <ColumnDefinition
                            Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="LoginTabButton"
                        Grid.Column="0"
                        Height="58"
                        Style="{StaticResource RuckuZImageButton}"
                        Click="LoginTab_Click">

                        <Grid>
                            <Image
                                x:Name="LoginTabArt"
                                Source="ms-appx:///Assets/buttons/light/buttonlight.png"
                                Stretch="Fill"/>

                            <TextBlock
                                Text="Login"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource RuckuZFont}"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#4B347C"/>

                        </Grid>
                    </Button>

                    <Button
                        x:Name="RegisterTabButton"
                        Grid.Column="1"
                        Height="58"
                        Style="{StaticResource RuckuZImageButton}"
                        Click="RegisterTab_Click">

                        <Grid>
                            <Image
                                x:Name="RegisterTabArt"
                                Source="ms-appx:///Assets/buttons/light/buttonlight.png"
                                Stretch="Fill"
                                Opacity="0.54"/>

                            <TextBlock
                                Text="Register"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource RuckuZFont}"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="#4B347C"
                                Opacity="0.7"/>

                        </Grid>
                    </Button>
                </Grid>

                <Grid
                    x:Name="UsernameShell"
                    Height="60"
                    Visibility="Collapsed">

                    <Image
                        Source="ms-appx:///Assets/buttons/light/inputlight.png"
                        Stretch="Fill"/>

                    <TextBox
                        x:Name="UsernameInput"
                        Margin="18,5"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        PlaceholderText="Username"
                        FontFamily="{StaticResource RuckuZFont}"
                        FontSize="18"
                        Foreground="#30254F"
                        VerticalContentAlignment="Center"/>

                </Grid>

                <Grid
                    Height="60">

                    <Image
                        Source="ms-appx:///Assets/buttons/light/inputlight.png"
                        Stretch="Fill"/>

                    <TextBox
                        x:Name="EmailInput"
                        Margin="18,5"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        PlaceholderText="Email"
                        FontFamily="{StaticResource RuckuZFont}"
                        FontSize="18"
                        Foreground="#30254F"
                        VerticalContentAlignment="Center"/>

                </Grid>

                <Grid
                    Height="60">

                    <Image
                        Source="ms-appx:///Assets/buttons/light/inputlight.png"
                        Stretch="Fill"/>

                    <TextBlock
                        x:Name="PasswordPlaceholder"
                        Text="Password"
                        Margin="18,0"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource RuckuZFont}"
                        FontSize="18"
                        Foreground="#746C82"
                        IsHitTestVisible="False"/>

                    <PasswordBox
                        x:Name="PasswordInput"
                        Margin="18,5"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        FontFamily="Segoe UI"
                        FontSize="18"
                        Foreground="#30254F"
                        VerticalContentAlignment="Center"
                        PasswordChanged="PasswordInput_PasswordChanged"/>

                </Grid>

                <Button
                    x:Name="ForgotPasswordButton"
                    Content="Forgot password?"
                    HorizontalAlignment="Right"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="{StaticResource RuckuZFont}"
                    FontSize="15"
                    Foreground="#6B58B8"
                    Click="ForgotPassword_Click"/>

                <Button
                    x:Name="LoginButton"
                    Height="66"
                    Margin="0,4,0,0"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource RuckuZImageButton}"
                    Click="LoginButton_Click">

                    <Grid>
                        <Image
                            Source="ms-appx:///Assets/buttons/light/buttonlight.png"
                            Stretch="Fill"/>

                        <TextBlock
                            x:Name="AuthButtonLabel"
                            Text="Login"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{StaticResource RuckuZFont}"
                            FontSize="21"
                            FontWeight="Bold"
                            Foreground="#4B347C"/>

                    </Grid>
                </Button>

                <TextBlock
                    x:Name="ModeHint"
                    Text="Don't have an account? Register"
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    FontFamily="{StaticResource RuckuZFont}"
                    FontSize="17"
                    Foreground="#625B70"/>

                <TextBlock
                    x:Name="StatusText"
                    MinHeight="22"
                    Text=""
                    HorizontalAlignment="Center"
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    FontFamily="{StaticResource RuckuZFont}"
                    FontSize="16"
                    Foreground="#8B3F63"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
