<?xml version="1.0" encoding="utf-8"?>

<Window
    x:Class="RuckuZ.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RuckuZ">

    <Grid
        Background="#17151C">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="1.15*"/>
            <ColumnDefinition
                Width="0.85*"/>
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Column="0">

            <StackPanel
                Width="430"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">

                <TextBlock
                    Text="RuckuZ"
                    FontSize="64"
                    FontWeight="Bold"
                    Foreground="#FFFFFF"/>

                <TextBlock
                    Text="Talk. Share. Cause a little RuckuZ."
                    FontSize="21"
                    Foreground="#BEB8C8"
                    TextWrapping="Wrap"/>

            </StackPanel>
        </Grid>

        <Grid
            Grid.Column="1"
            Background="#201D26">

            <Border
                Width="390"
                Padding="34"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#292530"
                BorderBrush="#40394A"
                BorderThickness="1"
                CornerRadius="8">

                <StackPanel
                    Spacing="16">
                    <TextBlock
                        Text="Welcome back"
                        FontSize="29"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFF"/>

                    <TextBlock
                        Text="Login to your RuckuZ account."
                        Margin="0,-8,0,10"
                        FontSize="15"
                        Foreground="#AAA4B2"/>

                    <TextBlock
                        Text="Email"
                        Foreground="#DDD8E2"/>

                    <TextBox
                        x:Name="EmailInput"
                        PlaceholderText="you@example.com"
                        Height="44"
                        FontSize="16"/>

                    <TextBlock
                        Text="Password"
                        Margin="0,4,0,0"
                        Foreground="#DDD8E2"/>

                    <PasswordBox
                        x:Name="PasswordInput"
                        PlaceholderText="Password"
                        Height="44"
                        FontSize="16"/>

                    <Button
                        x:Name="LoginButton"
                        Content="Login"
                        Height="46"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        FontSize="16"
                        Click="LoginButton_Click"/>

                    <TextBlock
                        x:Name="StatusText"
                        MinHeight="20"
                        Text=""
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Foreground="#FF8D8D"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
